{
    "framework": "nextjs",
    "buildCommand": "next build",
    "outputDirectory": ".next",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/enrollment-emails",
            "schedule": "0 12 * * *"
        }
    ]
}
