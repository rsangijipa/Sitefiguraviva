# Core
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=

# Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase (P2 Migration Target)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PIX (manual/offline payment confirmation flow). Leave PIX_MERCHANT_KEY empty
# to disable the PIX QR Code — the enrollment stepper will fall back to a
# "we'll contact you" message instead of generating a fake code.
PIX_MERCHANT_KEY=
PIX_MERCHANT_NAME="INSTITUTO FIGURA VIVA"
PIX_MERCHANT_CITY="SAO PAULO"

# Admin
ADMIN_BOOTSTRAP_EMAILS="admin@example.com"
# Credenciais opcionais apenas para uma carga local de demonstracao.
DEMO_ADMIN_EMAIL=admin@figuraviva.local
DEMO_ADMIN_PASSWORD=change-me-locally

# Feature Flags
NEXT_PUBLIC_FEATURE_NEW_GALLERY_FLOW=false
NEXT_PUBLIC_FEATURE_MAINTENANCE_MODE=false
NEXT_PUBLIC_FEATURE_DEBUG_TELEMETRY=true
FEATURE_SUPABASE_ADMIN_COURSES=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
