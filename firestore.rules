rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    
    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true ||
         request.auth.token.role in ['admin', 'administrador', 'ADMIN']) &&
        request.auth.token.isActive != false;
    }
    
    function isStaff() {
      return isAdmin() || (
        isSignedIn() &&
        request.auth.token.role == 'tutor' &&
        request.auth.token.isActive != false
      );
    }

    function isEnrolled(courseId) {
      let enrollmentId = uid() + '_' + courseId;
      return exists(/databases/$(database)/documents/enrollments/$(enrollmentId))
             && get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.status in ['active', 'completed'];
    }

    // Default: Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSafeProfileFieldUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'photoURL',
        'bio',
        'phone',
        'whatsapp',
        'timezone',
        'locale',
        'preferences',
        'notificationPreferences',
        'updatedAt',
        'lastSeenAt'
      ]);
    }

    function isSafeProfileCreate() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'photoURL',
        'bio',
        'phone',
        'whatsapp',
        'timezone',
        'locale',
        'preferences',
        'notificationPreferences',
        'createdAt',
        'updatedAt',
        'lastSeenAt'
      ]);
    }

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn() && userId == uid();
      allow create: if isSignedIn() && userId == uid() &&
                    request.resource.data.uid == uid() &&
                    isSafeProfileCreate();
      allow update: if isSignedIn() && userId == uid() &&
                    isSafeProfileFieldUpdate();
      allow read, write: if isAdmin();
      
      // subcollections like enrollments
      match /enrollments/{courseId} {
        allow read: if isSignedIn() && userId == uid();
        allow write: if isAdmin(); // Server only
      }

      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && userId == uid();
        allow read, write: if isAdmin();
      }
    }

    // COURSES
    match /courses/{courseId} {
      allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || resource.data.isPublished == true; 
      allow write: if isAdmin() || isStaff();

      match /modules/{moduleId} {
        allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
        allow write: if isAdmin() || isStaff();

        match /lessons/{lessonId} {
          allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
          allow write: if isAdmin() || isStaff();

          match /blocks/{blockId} {
            allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
            allow write: if isAdmin() || isStaff();
          }
        }
      }

      match /materials/{materialId} {
        allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
        allow write: if isAdmin() || isStaff();
      }

      match /announcements/{announcementId} {
        allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
        allow write: if isAdmin() || isStaff();
      }

      match /communityThreads/{threadId} {
        allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
        allow create: if isEnrolled(courseId);
        allow update, delete: if isAdmin() || isStaff() || (isSignedIn() && resource.data.authorId == uid());

        match /replies/{replyId} {
          allow read: if isAdmin() || isStaff() || isEnrolled(courseId) || get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true;
          allow create: if isEnrolled(courseId);
          allow update, delete: if isAdmin() || isStaff() || (isSignedIn() && resource.data.authorId == uid());
        }
      }
    }

    // GLOBAL COMMUNITY THREADS
    match /community_threads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isStaff() || (isSignedIn() && resource.data.authorId == uid());
    }

    // GLOBAL ENROLLMENTS
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow write: if false; // Writes should be handled by server/admin
    }

    // TRANSACTIONS / PAYMENTS
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if false; // Server only
    }

    // PROGRESS
    match /progress/{progressId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // CERTIFICATES
    match /certificates/{certificateId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow write: if false; // Issued by backend
    }

    // EVENTS
    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.isPublic == true || (resource.data.enrolledOnly == true && isEnrolled(resource.data.courseId));
      allow write: if isAdmin();
    }

    // AUDIT & SYSTEM
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; 
    }
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /system/{docId} {
      allow read: if true; 
      allow write: if false;
    }

    // SITE SETTINGS (Public info)
    match /siteSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // GALLERY (Public)
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ASSESSMENT SUBMISSIONS
    match /assessmentSubmissions/{submissionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow create: if isSignedIn() &&
                    request.resource.data.userId == uid() &&
                    request.resource.data.status in ['pending', 'submitted'] &&
                    !request.resource.data.keys().hasAny(['gradedBy', 'score', 'percentage', 'passed']) &&
                    (
                      !request.resource.data.keys().hasAny(['courseId']) ||
                      isEnrolled(request.resource.data.courseId)
                    );
      allow update: if isSignedIn() &&
                    resource.data.userId == uid() &&
                    request.resource.data.userId == uid() &&
                    request.resource.data.assessmentId == resource.data.assessmentId &&
                    request.resource.data.courseId == resource.data.courseId &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gradedBy', 'score', 'percentage', 'passed']) &&
                    request.resource.data.status in ['pending', 'submitted'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // PUBLIC DOCUMENTS
    match /publicDocs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // BLOG POSTS
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PUBLIC GALLERY (Extended)
    match /publicGallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PUBLIC LIBRARY
    match /publicLibrary/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // STATIC PAGES
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TEAM MEMBERS
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PRESENCE (Real-time)
    match /presence/{presenceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (presenceId.startsWith(uid()) || isAdmin());
    }

    // APPLICATIONS / INTERESTS
    // Public submissions go through /api/applications/submit, which writes with
    // the Admin SDK and bypasses these rules. No client path creates one, so
    // the previous `allow create: if true` only left an unauthenticated write
    // open to spam.
    match /applications/{appId} {
      allow read, write: if isAdmin();
    }

    // GAMIFICATION
    match /gamification_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // STATS & INTERACTION
    match /stats/{statId} {
      allow read: if true;
      allow write: if statId == 'tree' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
    }

    // ANALYTICS (Optional/Pre-emptive)
    match /analytics_events/{eventId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
  }
}
